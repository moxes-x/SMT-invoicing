# Copy to backend/.env for local development. Never commit real secrets.
DEBUG=1
SECRET_KEY=change-me
DATABASE_URL=postgres://invoicing:invoicing@localhost:5432/invoicing
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_COOKIES=0

# Optional: automatic WhatsApp via the Cloud API (leave empty to use wa.me links only)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_TEMPLATE_INVOICE=invoice_new
# WHATSAPP_TEMPLATE_REMINDER=invoice_reminder
# WHATSAPP_TEMPLATE_QUOTE=quote_new

# Online payments (Lenco). Businesses paste their own keys in Settings; they're stored encrypted
# with this Fernet key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Confirm the sandbox API host with Lenco; for local e2e tests use the fake: http://localhost:8090/access/v2
# LENCO_SANDBOX_API_URL=https://sandbox.lenco.co/access/v2
